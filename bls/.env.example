# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored by default — never commit real secrets.

# Supabase project settings → API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase project settings → API → service_role key.
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Never import it from anything
# under src/app or src/components. Only scripts/seed.ts uses it today.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required guard for scripts/seed.ts — must be the literal value
# "development". The script refuses to run without it, so a seed command can
# never accidentally target a production project.
SEED_ENV=development
